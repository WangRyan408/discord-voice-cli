# Copy this file to .env and replace all three placeholders.
DISCORD_TOKEN=your_discord_user_token
DISCORD_GUILD=your_guild_id
DISCORD_CHANNEL=your_voice_channel_id

# VPS defaults: no physical/OS virtual audio devices or audio server required.
DISCORD_AUDIO_MODE=virtual
DISCORD_SELF_MUTE=true
DISCORD_SELF_DEAFEN=true

# To use your local microphone and speakers instead:
# DISCORD_AUDIO_MODE=device
# DISCORD_SELF_MUTE=false
# DISCORD_SELF_DEAFEN=false
